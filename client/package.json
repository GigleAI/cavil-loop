{
  "name": "cavil-loop-client",
  "productName": "Cavil Loop",
  "version": "0.1.0",
  "private": true,
  "description": "Local GitHub Project board client for cavil-loop",
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && node test/mutation/run.mjs",
    "test:mutation": "node test/mutation/run.mjs",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "start": "node scripts/build.mjs && electron .",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.9.3": true,
    "electron-winstaller": false
  }
}
