{
  "name": "cavil-loop-client",
  "productName": "Cavil Loop",
  "version": "0.5.2",
  "private": true,
  "description": "Local GitHub Project board client for cavil-loop",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && bash test/mutation/run.sh",
    "test:mutation": "MUTATION=1 bash test/mutation/run.sh",
    "test:rust": "node scripts/build.mjs && cd src-tauri && cargo test --workspace",
    "test:e2e": "node scripts/build.mjs --test-bridge && playwright test",
    "start": "tauri dev",
    "dist:mac": "tauri build --bundles app && node scripts/make-dmg.mjs",
    "test:tauri": "playwright test -c playwright.tauri.config.ts && bash test/tauri/mutations.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "parse5": "7.3.0"
  }
}
